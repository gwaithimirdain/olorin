(executable
  (libraries bwd js_of_ocaml zarith zarith_stubs_js uutf narya.modal narya.core narya.parser narya.top)
  (name olorin)
  (modes js)
  (preprocess (pps js_of_ocaml-ppx)))

;; Warnings are errors in every profile, not just dev.  We build the app with --profile release
;; (see scripts/build-static.sh: the dev profile's js_of_ocaml emits a 13MB inline source map),
;; and release's :standard is only "-w -40", which leaves OCaml's own defaults -- where warnings
;; like 9 (a record pattern missing a field) and 33 (an unused open) are off entirely.  So we spell
;; out dev's warning set here, after :standard, and then turn off the two we don't want.
(env (_ (flags (:standard -w @1..3@5..28@30..39@43@46..47@49..57@61..62@67@69-40 -w -69 -w -32))))
